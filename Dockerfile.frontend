# WO-22B / AD-16 §5 / Architect decision (same-origin API via reverse proxy, post-incident):
# frontend for Cloud Run — a SEPARATE Cloud Run service from the public backend (kodomo-ai-backend,
# untouched by this file) AND from kodomo-ai-admin (Dockerfile.admin — never built or served from
# here, per AD-16: "nothing admin-related ships in the public frontend"). Serves the Vite
# production build (dist/): the LP at /, the app at /play/, the AD-13/16 Family Account screens at
# /login/, /account/, /claim/, the printable deck/kit at /print/deck/ and /print/kit/, legal pages
# at /legal/tokushoho/ and /legal/privacy/ — every real route from vite.config.ts's own multi-page
# `input` map, each with its own real index.html.
#
# This is a MULTI-PAGE static site, not a client-side-routed single-page app — there is no
# client-side router anywhere in this codebase. The one thing that would break it is a SPA
# catch-all rewrite ("send every unknown path to index.html"): that would silently serve the
# landing page for /play/, /print/kit/, etc. instead of their own real pages — see
# backend/server/frontendIndex.ts's own header comment, which serves each route's own real
# file/directory index.html and correctly 404s on a genuinely unknown path.
#
# A real production incident (a CORS/session mismatch between this service's own two default
# Cloud Run hostnames) is why this is no longer a bare static file server: backend/server/
# frontendIndex.ts is a small Express server that (1) serves the SAME static build `serve` used
# to, (2) reverse-proxies `/api/*` to the backend Cloud Run service server-side — the browser
# only ever talks to ONE origin now, no cross-origin CORS anywhere in the app — and (3)
# 301-redirects any Host other than the one canonical hostname to it, so a family can never again
# land on an alias origin whose session/CORS state silently diverges from the canonical one.

# ---- 1. build the production frontend (static assets) --------------------------------------
FROM node:22-slim AS build-ui
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
# Explicit COPY list, never a blanket `COPY . .` — see .dockerignore's own header comment for
# why: Google Cloud Build's builder doesn't support a per-Dockerfile ignore override, so this is
# what actually scopes the build context now, not the ignore file. `tsc -b` (part of `npm run
# build`) resolves every route directory vite.config.ts's own multi-page `input` map builds, plus
# `shared/` (a real relative import target — src/family/api.ts, src/family/progressBridge.ts,
# src/shell/ProfilePicker.tsx) and `backend/` (only because src/admin/*.ts type-imports backend
# schema types — src/admin is real source but never referenced by any vite entry here, so it's
# never actually bundled into dist/; copying it into this discarded build stage is harmless and
# far simpler than trying to exclude one subdirectory from an otherwise-needed `src/` copy).
COPY tsconfig.json vite.config.ts index.html ./
COPY src ./src
COPY shared ./shared
COPY backend ./backend
COPY play ./play
COPY login ./login
COPY account ./account
COPY claim ./claim
COPY print ./print
COPY legal ./legal
COPY design ./design
COPY public ./public
# Architect decision: same-origin API via reverse proxy — the browser now only ever calls this
# SAME origin's own `/api/*` (backend/server/frontendIndex.ts proxies it server-side), so this is
# a FIXED relative path, never a cross-origin backend URL baked into the client bundle. No build
# arg needed for it any more; requirement 8's own "no cross-origin API host in the bundle" check
# is satisfied by construction (the value is a plain path, not a URL — there is no host in it to
# find).
ENV VITE_FAMILY_API_URL=/api/v1
# Same build-time-only requirement as before: import.meta.env.VITE_SHOPIFY_PRODUCT_URL is inlined
# at build time (src/lp/LandingPage.tsx). The frontend's own fallback (an honest
# "お申し込みは近日公開予定です" pending state, never a dead href="#") already covers its absence
# correctly, so omitting this ARG has never been unsafe; it just means there's no way to supply
# the real Shopify product URL at deploy time.
ARG VITE_SHOPIFY_PRODUCT_URL
ENV VITE_SHOPIFY_PRODUCT_URL=$VITE_SHOPIFY_PRODUCT_URL
RUN npm run build

# ---- 2. compile backend/server/frontendIndex.ts -> dist-server/**/*.js (same as Dockerfile's
#         own step 1, and Dockerfile.admin's own build-server stage) -------------------------
FROM node:22-slim AS build-server
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.server.json ./
COPY backend ./backend
# shared/ is a real relative import target for backend/src (e.g. backend/src/schema.ts,
# backend/src/access.ts) — not optional context, same reasoning as Dockerfile's own matching
# comment.
COPY shared ./shared
RUN npx tsc -p tsconfig.server.json

# ---- 3. production-only node_modules (no devDependencies) -----------------------------------
FROM node:22-slim AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev

# ---- 4. runtime — small, no build tools, no source, no devDependencies, no Firebase ----------
FROM node:22-slim
WORKDIR /app
ENV NODE_ENV=production
COPY --from=deps /app/node_modules ./node_modules
COPY --from=build-server /app/dist-server ./dist-server
COPY --from=build-ui /app/dist ./dist
COPY package.json ./

# Cloud Run injects PORT at runtime (default 8080 if unset, matching frontendIndex.ts's own
# fallback convention); EXPOSE here is documentation only, Cloud Run does not read it.
#
# CANONICAL_HOST and BACKEND_URL are RUNTIME env vars (--set-env-vars at `gcloud run deploy`
# time, .github/workflows/ci.yml), never build args — unlike the old VITE_FAMILY_API_URL, neither
# is baked into the client bundle; both are read by backend/server/frontendIndex.ts only, at
# container start.
EXPOSE 8080

# Official node:*-slim images already ship a low-privilege "node" user — no need to create one
# (same choice the existing backend Dockerfile already makes).
USER node

CMD ["node", "dist-server/backend/server/frontendIndex.js"]
