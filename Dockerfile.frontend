# WO-22B / AD-16 §5: frontend static site for Cloud Run — a SEPARATE Cloud Run service from the
# public backend (kodomo-ai-backend, untouched by this file) AND from kodomo-ai-admin
# (Dockerfile.admin — never built or served from here, per AD-16: "nothing admin-related ships
# in the public frontend"). Serves the Vite production build (dist/): the LP at /, the app at
# /play/, the AD-13/16 Family Account screens at /login/, /account/, /claim/, the printable
# deck/kit at /print/deck/ and /print/kit/, legal pages at /legal/tokushoho/ and /legal/privacy/
# — every real route from vite.config.ts's own multi-page `input` map, each with its own real
# index.html.
#
# This is a MULTI-PAGE static site, not a client-side-routed single-page app — there is no
# client-side router anywhere in this codebase. The one thing that would break it is a SPA
# catch-all rewrite ("send every unknown path to index.html"): that would silently serve the
# landing page for /play/, /print/kit/, etc. instead of their own real pages — exactly the
# mistake docs/launch-runbook.md's own Firebase Hosting config comment already warns against for
# this same app. `serve` (below) is run WITHOUT its `-s`/`--single` SPA-rewrite flag for exactly
# that reason: it serves each route's own real file/directory index.html, and correctly 404s on
# a genuinely unknown path, matching the Firebase Hosting behavior this replaces (WO-22B: Firebase
# CLI auth is blocked on the deployment machine, so this packages the same build for Cloud Run
# instead — no product/content/behavior change, packaging only).

# ---- 1. build the production frontend -----------------------------------------------------
FROM node:22-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
# Explicit COPY list, never a blanket `COPY . .` — see .dockerignore's own header comment for
# why: Google Cloud Build's builder doesn't support a per-Dockerfile ignore override, so this is
# what actually scopes the build context now, not the ignore file. `tsc -b` (part of `npm run
# build`) resolves every route directory vite.config.ts's own multi-page `input` map builds, plus
# `shared/` (a real relative import target — src/family/api.ts, src/family/progressBridge.ts,
# src/shell/ProfilePicker.tsx) and `backend/` (only because src/admin/*.ts type-imports backend
# schema types — src/admin is real source but never referenced by any vite entry here, so it's
# never actually bundled into dist/; copying it into this discarded build stage is harmless and
# far simpler than trying to exclude one subdirectory from an otherwise-needed `src/` copy).
COPY tsconfig.json vite.config.ts index.html ./
COPY src ./src
COPY shared ./shared
COPY backend ./backend
COPY play ./play
COPY login ./login
COPY account ./account
COPY claim ./claim
COPY print ./print
COPY legal ./legal
COPY design ./design
COPY public ./public
# AD-13 §1: the Family Account API base URL — inlined at BUILD time (Vite bakes
# import.meta.env.VITE_FAMILY_API_URL into the static bundle; see src/family/api.ts), so it must
# be a build arg here, never a container env var. Omit it and every family feature (/login,
# /account, /claim, purchase, unit-open/trial gating) keeps the existing, already-shipped honest
# "not configured" fallback instead of silently pointing at nothing — but omitting it in a real
# production build means the app can never actually reach the backend, so this MUST be supplied
# once kodomo-ai-backend has a real, stable URL (docs/launch-runbook.md).
ARG VITE_FAMILY_API_URL
ENV VITE_FAMILY_API_URL=$VITE_FAMILY_API_URL
# Same build-time-only requirement as VITE_FAMILY_API_URL above, for the same reason:
# import.meta.env.VITE_SHOPIFY_PRODUCT_URL is inlined at build time (src/lp/LandingPage.tsx).
# The frontend's own fallback (an honest "お申し込みは近日公開予定です" pending state, never a
# dead href="#") already covers its absence correctly, so omitting this ARG has never been
# unsafe; it just means there's no way to supply the real Shopify product URL at deploy time.
ARG VITE_SHOPIFY_PRODUCT_URL
ENV VITE_SHOPIFY_PRODUCT_URL=$VITE_SHOPIFY_PRODUCT_URL
RUN npm run build

# ---- 2. runtime — static file server only: no Node build tools, no source, no Firebase ----
FROM node:22-slim
WORKDIR /app
ENV NODE_ENV=production
# `serve` (Vercel's static file server) — the only runtime dependency this image needs. No
# Firebase package anywhere in this image or its dependency tree.
RUN npm install --global serve@14
COPY --from=build /app/dist ./dist

# Cloud Run injects PORT at runtime (default 8080 if unset, matching backend/server/index.ts's
# own fallback convention); EXPOSE here is documentation only, Cloud Run does not read it.
EXPOSE 8080

# Official node:*-slim images already ship a low-privilege "node" user — no need to create one
# (same choice the existing backend Dockerfile already makes).
USER node

# No -s/--single: see the file-level comment above for why that flag must never be added here.
CMD ["sh", "-c", "serve -l tcp://0.0.0.0:${PORT:-8080} dist"]
