# WO-22B: frontend-only build context. Overrides the root .dockerignore for
# `docker build -f Dockerfile.frontend` (BuildKit convention: <dockerfile>.dockerignore takes
# precedence over the root .dockerignore when present) — the root file excludes src/, index.html,
# vite.config.ts etc. because it's scoped for the BACKEND image (see Dockerfile's own comment);
# the frontend needs exactly those files and none of the backend's.
node_modules
dist
dist-server

.git
.github

# Backend service — not part of this image, and must not be touched by this work order.
backend
tsconfig.server.json

# Content pipeline — a separate CLI tool, never runs inside this service.
pipeline
data
scripts

tests
docs
*.md

.env
.env.*
*.local
.DS_Store
*.tsbuildinfo
