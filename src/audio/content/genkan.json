    {
      "speaker": "GUIDE",
      "text": "これで、ほんとうに わかった？",
      "audioUrl": "/audio/m1/1-2-genkan/05-guide.mp3",
      "pauseAfterMs": 350
    },
    {
      "speaker": "PONTA",
      "text": "うん。外はよごれてて、きたないから、でしょ？",
