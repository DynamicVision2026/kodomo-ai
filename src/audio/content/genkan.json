      "pauseAfterMs": 350
    },
    {
      "speaker": "GUIDE",
      "text": "あのくつで、おうちに入るときは？",
      "audioUrl": "/audio/m1/1-2-genkan/11-guide.mp3",
      "pauseAfterMs": 350
    },
    {
      "speaker": "PONTA",
      "text": "え？　そりゃ、ぬぐよ。……あれ？",
