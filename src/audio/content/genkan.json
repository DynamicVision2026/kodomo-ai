      "pauseAfterMs": 350
    },
    {
      "speaker": "GUIDE",
      "text": "あれ、まだ一回も、外ではいてないよね。",
      "audioUrl": "/audio/m1/1-2-genkan/09-guide.mp3",
      "pauseAfterMs": 350
    },
    {
      "speaker": "PONTA",
      "text": "うん。まだ、ぴかぴか。",
