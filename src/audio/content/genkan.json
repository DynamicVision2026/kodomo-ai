      "pauseAfterMs": 350
    },
    {
      "speaker": "GUIDE",
      "text": "おもしろいね。",
      "audioUrl": "/audio/m1/1-2-genkan/14-guide.mp3",
      "pauseAfterMs": 1000
    },
    {
      "speaker": "GUIDE",
      "text": "まだ わからないのは、どこ？",
