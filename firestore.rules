rules_version = '2';

// AD-13 §1: "Firestore is accessed only by the backend through its service account (Admin SDK).
// Firestore security rules are set to deny all client access." The backend's Admin SDK
// (backend/server/firestoreDb.ts) always bypasses these rules entirely — this file only ever
// governs a DIRECT client (browser/mobile) connection, which AD-13's architecture never uses.
// Deliberately blanket-deny, not per-collection allow rules: there is no legitimate client read
// or write path to add an exception for, and a narrower rule here would only be an invitation to
// eventually punch a hole in it.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
