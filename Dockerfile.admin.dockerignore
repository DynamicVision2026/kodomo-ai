# AD-16 §8: admin-only build context. Overrides the root .dockerignore for
# `docker build -f Dockerfile.admin` (BuildKit convention: <dockerfile>.dockerignore takes
# precedence over the root .dockerignore when present) — the root file excludes src/,
# admin-dashboard/, backend/, vite.admin.config.ts, etc. because those are scoped OUT of the
# public frontend/backend images; this image needs exactly those and none of the public
# frontend's own route directories.
node_modules
dist
dist-admin
dist-server

.git
.github

# Public frontend's own route directories/entry — not part of this image.
play
login
account
claim
print
legal
design
index.html
vite.config.ts

# Content pipeline — a separate CLI tool, never runs inside this service.
pipeline
data
scripts

tests
docs
*.md

.env
.env.*
*.local
.DS_Store
*.tsbuildinfo
